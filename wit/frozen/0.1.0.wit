// Contratto WIT che rispecchia `fubmd-abi`. VIVO da M2, congelato a M4.
//
// Regola d'oro: ogni tipo che attraversa una firma di trait è un record/variant/
// enum WIT. I valori JSON liberi (frontmatter, attrs, args, storage) passano come
// stringa JSON (`type json = string`), scelta deliberata per preservare l'escape
// hatch. Vedi docs/architecture/traits.md per la tabella di mapping.
//
// ALBERI RICORSIVI — WIT non ammette tipi ricorsivi, e `Block`, `Inline`,
// `UiNode` lo sono. Al confine viaggiano come ARENA: una lista piatta di nodi
// più indici `u32` (`block-ref`, `inline-ref`, `ui-ref`) al posto dei
// riferimenti diretti. I tipi Rust nativi restano alberi veri; la conversione
// albero↔arena è `fubmd_abi::arena` (con round-trip sotto test), e il proxy
// WASM di M5 la chiamerà invece di riscriverla. Decisione e motivazioni in
// docs/architecture/traits.md, "Alberi ricorsivi al confine".
//
// KEYWORD WIT — `list`, `result` e `from` sono parole chiave del linguaggio:
// dove sono nomi di variante o di campo compaiono con l'escape `%`. È solo
// sintassi: l'identificatore dichiarato resta `list`/`result`/`from`, e i tipi
// Rust non cambiano.
//
// HOST-API — `host-api` è IMPORTATO dal world: le sue funzioni non compaiono
// come parametro di nessun'altra funzione, anche là dove il metodo Rust
// corrispondente prende un `&mut dyn HostApi`. Il test di conformità verifica
// l'elisione, non la assume.
//
// Stato conformità: `crates/fubmd-abi/tests/wit_conformance.rs` PARSA questo
// file con `wit-parser` e confronta con `fubmd-abi`, nelle due direzioni, i
// nomi *e i tipi*: campi dei record (in ordine), payload dei casi di variant,
// destinazioni degli alias, firme complete delle funzioni. Un WIT invalido =
// test rosso.

package fubmd:abi@0.1.0;

/// JSON serializzato come stringa: frontmatter, `attrs` dell'escape hatch,
/// argomenti dei comandi, storage dei plugin.
interface json {
    type json = string;
}

/// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): questa interfaccia non
/// esisteva. Ci sta perché i quattro tipi qui sotto la nominano dopo il ritaglio;
/// la sua aggiunta al contratto corrente è additiva e non avrebbe richiesto
/// nulla.
interface options {
    use json.{json};

    record option-entry {
        key: string,
        value: json,
    }
    type option-map = list<option-entry>;
}

/// Il modello di documento comune e agnostico rispetto al formato.
interface model {
    use json.{json};

    /// Path relativo al vault, separatori `/`, estensione inclusa.
    type doc-id = string;

    /// Intervallo [start, end) in byte sulla sorgente.
    ///
    /// Lato Rust i campi sono `usize` (indicizzano `&str` in memoria); qui sono
    /// `u64` perché il confine deve avere una larghezza fissa. Su wasm32
    /// `usize` è a 32 bit: usize→u64 è sempre lecito, u64→usize passa da una
    /// conversione controllata nel proxy (un documento più grande di 4 GiB non
    /// entrerebbe comunque nella memoria di un modulo wasm32).
    record span {
        start: u64,
        end: u64,
    }

    /// Metadati del documento (frontmatter proiettato su JSON).
    type frontmatter = json;

    /// Un heading estratto (outline e link a heading).
    record heading {
        level: u8,
        text: string,
        slug: string,
        span: span,
    }

    /// Un tag `#foo` / `#foo/bar` estratto.
    record tag {
        name: string,
        span: span,
    }

    /// Un'ancora di blocco esplicita (`^abc123`). `span` è il blocco intero
    /// (ciò che un embed ritaglia), `marker` il solo token (ciò che si toglie
    /// esportando). `id` è canonico: `fubmd_abi::model::canonical_anchor`.
    record anchor {
        id: string,
        span: span,
        marker: span,
    }

    /// Intento di link non risolto; la risoluzione a doc-id è del kernel.
    /// L'embed NON è qui: incorporare è un fatto del riferimento, non del
    /// bersaglio (`link.embed`), e la stessa nota si può linkare e incorporare.
    record link-target-wiki {
        page: string,
        heading: option<string>,
        block: option<string>,
    }
    variant link-target {
        wiki(link-target-wiki),
        url(string),
        path(string),
    }

    /// Un link estratto, piatto, con span e contesto per i backlink.
    record link {
        target: link-target,
        embed: bool,
        span: span,
        context: option<string>,
    }

    /// Il valore di una proprietà del frontmatter, normalizzato: senza, ogni
    /// consumatore reinventerebbe il parsing delle date. La verità grezza resta
    /// `frontmatter` (JSON); questa è la sua lettura.
    record property-date {
        year: s32,
        month: u8,
        day: u8,
        time: option<property-time>,
    }
    /// Fuso COME ERA SCRITTO: `offset-minutes` assente = orario senza fuso,
    /// che il modello non indovina (il fuso dell'utente è una capacità).
    record property-time {
        hour: u8,
        minute: u8,
        second: u8,
        offset-minutes: option<s16>,
    }
    /// La voce di un elenco: `property-value` meno la lista. La lista di liste
    /// non è esprimibile al confine (WIT non ha tipi ricorsivi) e cade in
    /// `unknown`, che è JSON e quindi non perde niente.
    variant property-scalar {
        empty,
        text(string),
        number(f64),
        %bool(bool),
        date(property-date),
        link(link-target),
        unknown(json),
    }
    variant property-value {
        /// `chiave:` senza valore. Diverso da chiave assente.
        empty,
        text(string),
        number(f64),
        %bool(bool),
        date(property-date),
        /// Una relazione: `autore: "[[Mario Rossi]]"`.
        link(link-target),
        %list(list<property-scalar>),
        /// Ciò che non si normalizza (oggetti annidati): il JSON com'è.
        unknown(json),
    }

    // --- albero a blocchi / inline, come arena piatta -------------------------
    //
    // `Vec<Inline>` diventa `list<inline-ref>`, `Vec<Block>` diventa
    // `list<block-ref>`: i nodi veri stanno tutti in `document-tree`.

    /// Indice in `document-tree.inlines`. Fuori range = modello malformato.
    type inline-ref = u32;
    /// Indice in `document-tree.blocks`. Fuori range = modello malformato.
    type block-ref = u32;

    record inline-link {
        target: link-target,
        label: option<list<inline-ref>>,
        embed: bool,
        span: span,
    }
    record inline-tag-ref {
        name: string,
        span: span,
    }
    record inline-custom {
        custom-kind: string,
        attrs: json,
        span: span,
    }
    variant inline {
        text(string),
        emph(list<inline-ref>),
        strong(list<inline-ref>),
        code(string),
        link(inline-link),
        tag-ref(inline-tag-ref),
        custom(inline-custom),
    }

    // Ogni blocco porta un `anchor`: per un heading è lo slug generato dal
    // testo (`heading-slug`), per gli altri l'id esplicito `^abc123` scritto in
    // coda (`canonical-anchor`). È ciò che rende indirizzabile un pezzo di
    // documento — link a blocco, embed di blocco, deep link, diff a blocchi.

    record block-heading {
        level: u8,
        inlines: list<inline-ref>,
        anchor: option<string>,
        span: span,
    }
    record block-paragraph {
        inlines: list<inline-ref>,
        anchor: option<string>,
        span: span,
    }
    /// Il marcatore di una task: cosa c'è fra le parentesi (`none` = `[ ]`) e
    /// DOVE. Lo span è quello del SIMBOLO (`[ ]` → lo spazio, `[x]` → la `x`):
    /// spuntare è la sostituzione di un carattere, non una riscrittura.
    /// Un carattere e non un booleano: gli stati personalizzati (`[/]`, `[-]`,
    /// `[>]`) sono una richiesta esplicita del prodotto e nascono tutti qui.
    record task-marker {
        symbol: option<char>,
        span: span,
    }
    /// Una voce di lista. Non è una `list<block-ref>` nuda perché una voce PUÒ
    /// essere una task, e una task list rappresentata come lista di paragrafi
    /// obbliga ogni consumatore a ricominciare dal parsing del testo.
    record list-item {
        blocks: list<block-ref>,
        task: option<task-marker>,
        span: span,
    }
    record block-list {
        ordered: bool,
        items: list<list-item>,
        anchor: option<string>,
        span: span,
    }
    record block-code-block {
        lang: option<string>,
        code: string,
        anchor: option<string>,
        span: span,
    }
    record block-quote {
        blocks: list<block-ref>,
        anchor: option<string>,
        span: span,
    }
    record block-thematic-break {
        anchor: option<string>,
        span: span,
    }
    /// Escape hatch: callout, math, footnote, definition list. I `custom-kind`
    /// condivisi stanno in `fubmd_abi::model::custom_kind` e nella tabella di
    /// docs/architecture/data-model.md.
    record block-custom {
        custom-kind: string,
        attrs: json,
        blocks: list<block-ref>,
        anchor: option<string>,
        span: span,
    }
    /// Una cella porta INLINE, non blocchi: è la ragione per cui la tabella non
    /// stava dentro `block-custom` (che porta solo blocchi) e degenerava in
    /// `custom("table")` di `custom("block")` indistinguibili.
    record table-cell {
        inlines: list<inline-ref>,
        span: span,
    }
    record table-row {
        cells: list<table-cell>,
    }
    enum column-align { none, left, center, right }
    /// L'unica delle tre candidate promossa a variante: chi la consuma è
    /// trasversale al formato (database su file, CSV/JSON, Pandoc/Typst,
    /// stampa, chunking) e ha bisogno di righe, celle e allineamento come tipo.
    record block-table {
        head: option<table-row>,
        rows: list<table-row>,
        /// Per colonna, in ordine; può essere più corta delle righe.
        align: list<column-align>,
        anchor: option<string>,
        span: span,
    }
    variant block {
        heading(block-heading),
        paragraph(block-paragraph),
        %list(block-list),
        code-block(block-code-block),
        quote(block-quote),
        thematic-break(block-thematic-break),
        custom(block-custom),
        table(block-table),
    }

    /// Il corpo del documento: arena dei nodi + radici in ordine di lettura.
    /// Lato Rust è `Vec<Block>` (albero); qui è appiattito.
    record document-tree {
        blocks: list<block>,
        inlines: list<inline>,
        roots: list<block-ref>,
    }

    /// Il documento parsato nel modello comune.
    record document-model {
        id: doc-id,
        frontmatter: frontmatter,
        body: document-tree,
        outline: list<heading>,
        links: list<link>,
        tags: list<tag>,
        /// Ancore di blocco esplicite, piatte: è così che il kernel risolve un
        /// `[[Nota#^blocco]]` senza camminare l'albero. Le ancore degli heading
        /// NON stanno qui: sono lo `slug` di `heading` in `outline`, perché
        /// `#titolo` e `#^blocco` sono due sintassi e due spazi di nomi diversi.
        anchors: list<anchor>,
        text: string,
    }
}

/// `FormatProvider`: come si comporta un formato di documento.
interface format {
    use json.{json};
    use model.{document-model};
    use options.{option-map};

    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): non esisteva, e
    /// `parse` prendeva una `string`. Con quella firma un `.canvas`, un CSV
    /// grande, un PDF trattato come documento (13.2) o un file con encoding da
    /// rilevare (2.3) non entravano affatto (§3.4).
    variant document-source {
        text(string),
        bytes(list<u8>),
    }
    record format-descriptor {
        id: string,
        name: string,
        extensions: list<string>,
    }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): erano cinque
    /// booleani (`wikilinks`, `tags`, `frontmatter`, `callouts`, `embeds`)
    /// contro le ~50 sintassi del 5.2 — e con quella forma ogni sintassi era un
    /// campo nuovo del contratto. Il vocabolario è ora lo stesso di
    /// `parse-context`, perché «cosa so fare» e «cosa devi accendere» sono la
    /// stessa domanda vista da due lati (§3.5 con §3.4).
    record format-capabilities {
        syntax: option-map,
    }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): erano `parse-tags`
    /// e `parse-wikilinks`, due booleani dove la coda è aperta (§3.4).
    record parse-context {
        doc-id: string,
        options: option-map,
    }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): non esisteva. Il
    /// rendering ha almeno tre bersagli distinti — schermo, stampa e PDF (6.3),
    /// pubblicazione statica (19.4) — e un booleano non ne distingueva due.
    enum render-target {
        screen,
        print,
        pdf,
        static-site,
    }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): era il solo
    /// `wikilinks-as-data-attrs: bool` (§3.5).
    record render-options {
        target: render-target,
        options: option-map,
    }
    variant format-error {
        parse(string),
        render(string),
        serialize(string),
        unsupported(string),
    }

    descriptor: func() -> format-descriptor;
    capabilities: func() -> format-capabilities;
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): `source` era una
    /// `string` (§3.4).
    parse: func(source: document-source, ctx: parse-context) -> result<document-model, format-error>;
    render-html: func(model: document-model, opts: render-options) -> result<string, format-error>;
    /// Generazione, non round-trip: la fonte di verità di un documento
    /// esistente è la sorgente; il kernel non riscrive mai un file da qui.
    serialize: func(model: document-model) -> result<string, format-error>;
}

/// Protocollo di UI dichiarativa (`UiNode`).
interface ui {
    use json.{json};
    use model.{span};

    type action-id = string;

    enum axis { row, column }
    enum intent { neutral, primary, danger }

    /// Indice in `ui-tree.nodes`. Fuori range = albero malformato.
    type ui-ref = u32;

    record ui-stack {
        dir: axis,
        gap: u8,
        children: list<ui-ref>,
    }
    record ui-heading {
        level: u8,
        content: string,
    }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0016): l'azione di un
    /// nodo era il solo `action-id`, e i dati che servivano a servire il click
    /// ci finivano concatenati dentro (`open:a/Uno.md`) — una convenzione
    /// privata delle tre feature ufficiali che stava diventando contratto de
    /// facto. Ora porta un payload del provider (§2.7).
    record action-ref {
        action: action-id,
        payload: json,
    }
    record ui-list-item {
        title: string,
        subtitle: option<string>,
        action: option<action-ref>,
        /// È l'elemento CORRENTE? Non è stile: è l'unica cosa che una lista non
        /// sa dire di sé, e senza chi ce l'ha se la scrive nel titolo — il §2.7
        /// in un'altra forma.
        selected: bool,
    }
    record ui-button {
        label: string,
        intent: intent,
        action: action-ref,
    }
    record ui-web-view {
        url: string,
        height: u32,
    }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0016): `ui-node` era
    /// questo `variant`, e ora è il record `{ key, kind }` che lo contiene. La
    /// chiave è ciò su cui un riconciliatore lavora (§2.8): senza, l'identità di
    /// un nodo è la sua posizione, e una lista che si riordina sposta il focus e
    /// la selezione insieme alle righe — con i nodi di input del §2.1, un campo
    /// di testo che si svuota a ogni salvataggio.
    variant ui-kind {
        stack(ui-stack),
        text(string),
        heading(ui-heading),
        %list(list<ui-ref>),
        list-item(ui-list-item),
        button(ui-button),
        /// SOLO codice fidato: l'host rifiuta `html`/`web-view` dai plugin
        /// (UiNode::validate_untrusted) — un plugin sandboxato non deve poter
        /// iniettare contenuto attivo nella webview principale.
        html(string),
        web-view(ui-web-view),
    }
    record ui-node {
        key: option<string>,
        kind: ui-kind,
    }

    /// Arena dell'albero UI: `root` indicizza `nodes`. Lato Rust è un
    /// `UiNode` (albero); qui è appiattito, stessa scelta di `document-tree`.
    record ui-tree {
        nodes: list<ui-node>,
        root: ui-ref,
    }

    record ui-action {
        action: action-id,
        payload: json,
    }
    record view-update-reveal {
        doc-id: string,
        span: span,
    }
    /// Varco di estensione degli intenti, con namespace (`ns` = plugin id).
    record view-update-custom {
        ns: string,
        payload: json,
    }
    variant view-update {
        replace(ui-tree),
        none,
        navigate(string),
        /// Apri (se serve) e porta la vista su un intervallo del documento:
        /// `span` è in byte UTF-8, chi disegna lo mappa sull'editor. Usato
        /// dall'outline per saltare a un heading.
        reveal(view-update-reveal),
        /// Esegui una ricerca e mostrane i risultati (usato dal pannello tag).
        run-search(string),
        /// Intento che il protocollo non prevede: la shell che non riconosce
        /// `ns` NON FA NULLA (degrado garbato, come gli altri `custom`). Gli
        /// intenti nuovi nascono qui e vengono promossi a varianti proprie
        /// solo se universali — è ciò che tiene l'enum chiudibile al freeze.
        custom(view-update-custom),
    }
}

/// Job: il varco per il lavoro lungo. Le chiamate dei trait sono sincrone e
/// brevi (a M5 una deadline le tronca); rete e calcolo pesante passano da un
/// job, eseguito dall'host FUORI dal giro sincrono del kernel. Dentro al job
/// non c'è host-api: input nel payload, output nel risultato.
interface jobs {
    use json.{json};

    /// Identità di un job lanciato: chi lo lancia riconosce il proprio esito
    /// nell'evento `job-done`.
    type job-id = u64;

    /// Richiesta di lavoro in background: `job` è il nome dell'entry point
    /// del plugin (`run-job`), `payload` porta tutto l'input necessario.
    record job-spec {
        job: string,
        payload: json,
    }
}

/// Eventi del ciclo di vita del vault.
interface events {
    use json.{json};
    use model.{doc-id};
    use jobs.{job-id};
    use errors.{plugin-error};

    record event-document-changed { id: doc-id }
    record event-document-removed { id: doc-id }
    /// L'identità È il path: chi tiene stato per-documento migra la chiave,
    /// non tratta il rename come remove+add. (`from` è keyword WIT: `%from`.)
    record event-document-renamed { %from: doc-id, to: doc-id }
    record event-vault-opened { root: string }
    /// Varco di estensione: eventi dei plugin, topic namespaced
    /// (`"<plugin-id>/<nome>"`).
    record event-custom { topic: string, payload: json }
    /// Esito di un job in background (vedi `host-api.spawn-job`): consegnato
    /// sul giro sincrono normale, riconosciuto dal lanciatore tramite `id`.
    record event-job-done {
        id: job-id,
        job: string,
        %result: result<json, plugin-error>,
    }
    /// Coda eventi troncata (budget anti-ping-pong): `dropped` eventi persi.
    /// Chi deriva stato dagli eventi deve riconciliare da zero. Mai silenzioso.
    record event-overflow { dropped: u64 }
    variant event {
        vault-opened(event-vault-opened),
        document-changed(event-document-changed),
        document-removed(event-document-removed),
        document-renamed(event-document-renamed),
        index-updated,
        job-done(event-job-done),
        overflow(event-overflow),
        custom(event-custom),
    }

    enum event-kind {
        vault-opened,
        document-changed,
        document-removed,
        document-renamed,
        index-updated,
        job-done,
        overflow,
        custom,
    }
    type event-mask = list<event-kind>;

    // LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0012). Questi tipi entrano nella
    // baseline perché `event-handler.handle` — la firma che la decisione 0012 ha rotto
    // apposta, e che è documentata sotto — li nomina: una baseline che non
    // parsa non è una baseline. Ciò che la decisione 0012 ha aggiunto in modo davvero
    // additivo (il caso `batch-ended` di `event` e di `event-kind`, e il record
    // `event-batch-ended`) NON sta qui: deve restare una crescita che il test di
    // additività vede come tale.
    type batch-id = u64;
    record actor-plugin { id: string }
    variant actor {
        user,
        watcher,
        kernel,
        plugin(actor-plugin),
    }
    record origin {
        actor: actor,
        batch: option<batch-id>,
    }
    record notice {
        event: event,
        origin: origin,
    }
}

/// Comandi: le azioni del vault dette in una forma che chi non ha letto il
/// codice può scegliere, compilare e invocare.
///
/// La palette si accontenterebbe di `{id, title}` — a scegliere e a compilare è
/// un umano. Tutto il resto di questa interfaccia esiste per gli **altri**
/// chiamanti dello stesso registro: la CLI (27.1), l'API locale (27.2), le
/// automazioni (16.2) e il centro di comando LLM (22.4). Vedi
/// `crates/fubmd-abi/src/command.rs`.
interface command {
    use json.{json};
    use model.{doc-id, span};
    use edit.{edit-request};
    use errors.{plugin-error};

    /// La specie di un argomento. Vocabolario chiuso e piccolo: sono le specie
    /// che un chiamante qualunque sa produrre senza conoscere il comando. NON
    /// sono i nodi di input della UI (§2.1): questi dicono *cosa* è un valore,
    /// quelli diranno *come* lo si chiede.
    variant param-kind {
        text,
        number,
        %bool,
        /// L'id di un documento: chi disegna un form può offrire il vault, chi
        /// valida sa che una stringa qualunque non va bene.
        document,
        /// Più documenti: la forma con cui si chiede un'operazione su *queste*
        /// note.
        documents,
        /// Uno fra valori dichiarati — dichiarati QUI, perché chi non ha letto
        /// il codice deve poterli vedere.
        choice(list<choice>),
    }
    /// Una scelta: il valore che viaggia e l'etichetta che si legge.
    record choice {
        value: string,
        title: string,
    }
    /// Un argomento di un comando. Un parametro non obbligatorio assente non ha
    /// un default nel contratto: cosa farne lo decide il comando, che è l'unico
    /// a saperlo.
    record param-spec {
        name: string,
        title: string,
        description: string,
        kind: param-kind,
        required: bool,
    }

    /// Fin dove arriva un comando, in ordine di raggio crescente: chi decide se
    /// chiedere conferma confronta.
    enum command-reach { session, document, documents, vault, settings }
    /// Il raggio dichiarato. `writes` è l'unico campo che l'host fa rispettare
    /// (chi si dichiara di sola lettura riceve un host che rifiuta le
    /// scritture); gli altri due sono dichiarazioni, e il piano del dry-run è
    /// ciò che le smentisce.
    record command-scope {
        writes: bool,
        reach: command-reach,
        reversible: bool,
    }

    /// Un comando offerto da un provider. `description` è inutile alla palette
    /// (c'è il titolo) ed è l'unico ingrediente su cui un chiamante non umano
    /// sceglie.
    record command-spec {
        id: string,
        title: string,
        description: string,
        keybinding: option<string>,
        params: list<param-spec>,
        scope: command-scope,
    }

    /// Come si sta invocando. Nessun default: un `apply` implicito è l'errore
    /// che questo enum esiste per rendere impossibile.
    enum invoke-mode {
        apply,
        /// Dimmi cosa faresti. L'host presta un `host-api` in SOLA LETTURA: non
        /// è una richiesta di buona condotta, è una garanzia.
        dry-run,
    }

    /// La modifica che un comando propone per UN documento.
    record planned-edit {
        doc: doc-id,
        edit: edit-request,
    }
    /// Cosa succederebbe. `docs` è la verità completa (ci sta anche ciò che un
    /// `edit-request` non esprime: creare, cestinare, rinominare); `edits` è il
    /// dettaglio mostrabile come diff. L'host completa `docs` con i documenti
    /// degli `edits`: quell'elenco è ciò che l'utente approva.
    record command-plan {
        summary: string,
        docs: list<doc-id>,
        edits: list<planned-edit>,
    }

    record command-effect-reveal {
        doc: doc-id,
        span: span,
    }
    record command-effect-custom {
        ns: string,
        payload: json,
    }
    /// Ciò che la shell deve fare dopo. Parente di `view-update` e non lo stesso
    /// tipo: da un comando non esiste una view da ridisegnare.
    variant command-effect {
        done,
        navigate(doc-id),
        reveal(command-effect-reveal),
        run-search(string),
        plan(command-plan),
        /// Varco di estensione con namespace: la shell che non riconosce `ns`
        /// non fa nulla (degrado garbato, come per `view-update`).
        custom(command-effect-custom),
    }

    /// L'esito: cosa dire all'utente e cosa deve fare la shell. Un record e non
    /// un enum perché le due cose capitano insieme. `notify` è TESTO SEMPLICE,
    /// mai markup.
    record command-outcome {
        notify: option<string>,
        effect: command-effect,
    }

    commands: func() -> list<command-spec>;
    /// Esegue (o simula) un comando. Gli argomenti arrivano già convalidati
    /// contro la `command-spec`: i `params` dichiarati sono la difesa del
    /// comando, e chi sbaglia riceve un `bad-args` che dice cosa manca.
    invoke: func(command: string, args: json, mode: invoke-mode) -> result<command-outcome, plugin-error>;
}

/// Il canale dati verso le view: ricerca, backlink, grafo, proprietà, salute
/// del vault (`IndexProvider`).
///
/// Ciò che non è esprimibile qui diventa un comando bespoke dell'app, cioè una
/// superficie che un plugin non può avere: è la ragione per cui questo enum è
/// largo. Chi risponde: il KERNEL per ciò di cui è già l'unica fonte di verità
/// (grafo, modelli, frontmatter), i provider registrati per il resto (il
/// full-text).
/// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0019): il canale dati.
///
/// Cinque rotture deliberate, tutte della stessa: la query smette di essere una
/// stringa nel linguaggio di una dipendenza e diventa un albero del contratto.
/// `search-scope`, `index-query-full-text`, `index-query-properties`,
/// `search-hit`, `document-properties`, `search-page` e `properties-page` sono
/// TOLTI; `index-query` e `index-result` perdono `full-text`/`properties` e
/// `search`/`properties` in favore di `documents`; `index-query-tags`,
/// `index-query-neighbors` e `index-query-property-values` cambiano il primo
/// campo (un'espressione al posto di un documento o di una lista di filtri); e
/// l'interfaccia guadagna `routes`, senza cui il dispatch resta per tentativi.
///
/// Perché non additivo: `full-text` e `properties` erano due modi di chiedere la
/// stessa cosa — quali documenti — in due lingue che non si potevano comporre,
/// e affiancare una terza variante avrebbe lasciato le prime due a dire la
/// stessa cosa peggio, per sempre. Il join fra testo e frontmatter non è un
/// campo in più: è l'unificazione delle due.
interface index {
    use json.{json};
    use model.{doc-id, document-model, span, heading, property-value, property-scalar};
    use errors.{plugin-error};

    /// La finestra chiesta su una risposta: sta nella DOMANDA perché chi la
    /// serve deve poter troncare prima di costruire il risultato. Assente =
    /// tutto; `limit: 0` = nessun elemento.
    record page {
        offset: u32,
        limit: u32,
    }

    /// In che verso si cammina il grafo dei link.
    enum link-direction { outbound, inbound, both }

    // --- il linguaggio delle interrogazioni (§5.3) -------------------------
    //
    // Prima qui c'era una stringa (`index-query-full-text.query`) e un ambito
    // accanto: la sintassi che l'utente digitava era quella del motore, e
    // «testo» e «proprietà» erano due domande che non si potevano comporre.
    // Adesso la domanda è un albero a due livelli in forma normale disgiuntiva
    // — OR di clausole, AND di letterali — e la stringa libera vive dentro una
    // foglia sola. Due livelli e non un albero qualunque: qui i tipi ricorsivi
    // passano solo per arena, e la DNF esprime ogni combinazione booleana ed è
    // già la forma che un query builder disegna.

    /// Come si intende la stringa di `text-query`.
    enum text-mode {
        /// Tutti i termini, in qualunque ordine.
        terms,
        /// La sequenza esatta.
        phrase,
    }
    /// Dove cercare il testo. Vuoto = i campi che il provider indicizza.
    enum text-field { name, body, tags }
    /// La foglia di testo: l'UNICA stringa libera del contratto.
    record text-query {
        text: string,
        mode: text-mode,
        fields: list<text-field>,
    }
    /// Un tag canonico (senza `#`); con `descendants` prende la sua gerarchia.
    record tag-predicate {
        name: string,
        descendants: bool,
    }
    /// Una cartella (senza slash finale, `""` = radice); con `descendants`
    /// prende anche le sottocartelle.
    record folder-predicate {
        path: string,
        descendants: bool,
    }
    /// I documenti in relazione di link: `inbound` = quelli che nominano `doc`.
    record linked-predicate {
        doc: doc-id,
        direction: link-direction,
    }
    /// Questi documenti, per nome: è la forma in cui il pianificatore consegna
    /// un sottoalbero che il destinatario non saprebbe valutare.
    record docs-predicate {
        docs: list<doc-id>,
    }
    /// Un predicato di terzi, con namespace. Chi non lo rivendica non lo riceve.
    record custom-predicate {
        ns: string,
        predicate: json,
    }
    /// Le foglie: ognuna è un fatto sul vault che qualcuno sa verificare.
    variant query-predicate {
        text(text-query),
        property(property-filter),
        tag(tag-predicate),
        folder(folder-predicate),
        linked(linked-predicate),
        docs(docs-predicate),
        custom(custom-predicate),
    }
    /// Un predicato, eventualmente negato: in forma normale la negazione finisce
    /// sulle foglie, ed è la casella «diverso da» di un builder.
    record query-literal {
        negated: bool,
        predicate: query-predicate,
    }
    /// I letterali sono in AND; vuota = ogni documento.
    record query-clause {
        all: list<query-literal>,
    }
    /// Le clausole sono in OR; vuoto = ogni documento (la query da cui parte un
    /// builder che non ha ancora nessun filtro).
    record query-expr {
        any: list<query-clause>,
    }

    /// Quali proprietà del frontmatter portarsi dietro in una risposta. Tre
    /// casi, perché «vuoto = tutte» è il default sbagliato per un elenco di
    /// risultati e «tutte» non si dice con una lista di chiavi ignote.
    variant property-select {
        none,
        all,
        keys(property-select-keys),
    }
    record property-select-keys {
        keys: list<string>,
    }

    /// Come si mette alla prova una proprietà.    /// Come si mette alla prova una proprietà. Un variant e non operatore+valore
    /// perché `exists`/`missing` un valore non ce l'hanno.
    variant property-test {
        exists,
        missing,
        equals(property-value),
        not-equals(property-value),
        /// Elenco: contiene lo scalare. Testo: sottostringa. Resto: uguaglianza.
        contains(property-scalar),
        /// Fra valori della stessa specie; specie diverse → falso, non errore.
        greater-than(property-value),
        less-than(property-value),
    }
    /// Più filtri di una query sono in AND (l'OR arriva con la query come AST).
    record property-filter {
        key: string,
        test: property-test,
    }
    /// Chi non ha la chiave finisce in fondo in entrambi i versi; a parità vale
    /// l'ordine dei doc-id, o una risposta paginata non è stabile.
    record property-sort {
        key: string,
        descending: bool,
    }

    /// Un controllo di salute del vault (7.2): ogni voce è un'interrogazione su
    /// grafo e modelli già in memoria.
    enum health-check {
        /// Link che non risolvono a nessun documento (un URL non è un link rotto).
        broken-links,
        /// Note che nessuno nomina: zero riferimenti entranti.
        orphan-documents,
    }

    record index-query-backlinks {
        target: doc-id,
        page: option<page>,
    }
    /// I documenti che combaciano: la variante che ha sostituito `full-text` e
    /// `properties`, che erano due modi di chiedere la stessa cosa in due lingue
    /// che non si potevano comporre.
    record index-query-documents {
        matching: query-expr,
        /// Assente = per rilevanza se c'è, altrimenti per doc-id.
        sort: option<property-sort>,
        select: property-select,
        page: option<page>,
    }
    /// `matching` vuoto = tutto il vault; altrimenti sono le FACCETTE di un
    /// risultato (quali tag hanno le note che parlano di rust).
    record index-query-tags {
        matching: query-expr,
        page: option<page>,
    }
    /// Il grafo (7.3) nel contratto. I semi sono un'espressione e non un
    /// documento solo: il grafo intero è `seeds` vuota, `depth: 1`, uscenti —
    /// una domanda sola invece di una per nota.
    record index-query-neighbors {
        seeds: query-expr,
        direction: link-direction,
        /// Passi di distanza, almeno 1 (`0` → risposta vuota).
        depth: u8,
        page: option<page>,
    }
    /// Le faccette di 9.1: un elenco contribuisce con ogni suo elemento. Si
    /// contano sui documenti già selezionati, o la navigazione per faccette non
    /// converge mai.
    record index-query-property-values {
        key: string,
        matching: query-expr,
        page: option<page>,
    }
    record index-query-vault-health {
        check: health-check,
        page: option<page>,
    }
    /// Varco di estensione: query di provider di terzi, con namespace
    /// (`ns` = plugin id). Chi non l'ha dichiarato non la riceve; se non l'ha
    /// dichiarato nessuno, il chiamante riceve `unserved`.
    record index-query-custom {
        ns: string,
        query: json,
    }
    variant index-query {
        documents(index-query-documents),
        backlinks(index-query-backlinks),
        /// La struttura (heading) di un documento, servita dai modelli in
        /// cache: è come una view legge la struttura parsata senza avere un
        /// `format-provider`. Documento inesistente → outline vuota. È l'unica
        /// senza finestra: cresce con un documento, non col vault.
        outline(doc-id),
        tags(index-query-tags),
        neighbors(index-query-neighbors),
        property-values(index-query-property-values),
        vault-health(index-query-vault-health),
        custom(index-query-custom),
    }

    /// La famiglia di una `index-query`: ciò che un indice dichiara di SERVIRE.
    /// `custom` porta il namespace — due plugin che estendono il canale non si
    /// contendono la stessa casella.
    variant query-kind {
        documents,
        backlinks,
        outline,
        tags,
        neighbors,
        property-values,
        vault-health,
        custom(string),
    }
    /// La specie di una foglia: ciò che un indice dichiara di saper VALUTARE.
    variant predicate-kind {
        text,
        property,
        tag,
        folder,
        linked,
        custom(string),
    }
    /// Cosa un indice dichiara alla registrazione. Una FAMIGLIA ha un
    /// proprietario solo (lì la risposta si compone, e due autori vorrebbero
    /// dire che vince l'ordine di montaggio); una FOGLIA può averne più d'uno,
    /// perché è un fatto sul vault e chi la rivendica promette la stessa
    /// risposta degli altri.
    variant query-route {
        query(query-kind),
        predicate(predicate-kind),
    }

    record backlink-ref {
        source: doc-id,
        context: option<string>,
    }
    /// `via` è l'anello precedente del cammino: senza, una risposta con
    /// `depth > 1` è un sacchetto di nodi; con, è un albero e gli archi si
    /// ricostruiscono. Arco `via → doc` per gli uscenti, `doc → via` per gli
    /// entranti.
    record neighbor-ref {
        doc: doc-id,
        via: doc-id,
        depth: u8,
    }
    record tag-count {
        name: string,
        count: u32,
    }
    record property-entry {
        key: string,
        value: property-value,
    }
    /// Un documento che ha combaciato, con ciò che la query gli ha attaccato
    /// addosso: la riga di una collezione (8.4), di un database su file (11) o
    /// di un elenco di risultati. È UN tipo dove prima erano due (`search-hit` e
    /// `document-properties`): finché «cerca» e «filtra» erano due varianti, il
    /// join fra le due era inesprimibile.
    ///
    /// `snippet` è testo semplice, mai markup: chi disegna lo inserisce come
    /// testo. L'evidenziazione passa da `highlights`, intervalli in byte DENTRO
    /// `snippet` (nessun varco di injection da un provider di terzi).
    record document-match {
        doc: doc-id,
        /// Presente quando a selezionare è stato (anche) del testo.
        score: option<f32>,
        snippet: option<string>,
        highlights: list<span>,
        properties: list<property-entry>,
    }
    /// La faccetta di 9.1, gemella di `tag-count` per il frontmatter.
    record property-count {
        value: property-value,
        count: u32,
    }
    record health-issue {
        doc: doc-id,
        check: health-check,
        /// Per un link rotto: la destinazione COME ERA SCRITTA (è ciò che serve
        /// per correggerla). Assente quando il problema è il documento stesso.
        detail: option<string>,
        /// Dove sta nel sorgente, quando il problema ha un punto.
        span: option<span>,
    }
    // Una risposta a finestra porta gli elementi, da dove cominciano e quanti ce
    // ne sarebbero IN TUTTO (`total` è il conteggio prima della finestra: senza,
    // "1-20 di 4321" non si scrive). Lato Rust è un solo `Paged<T>` generico;
    // qui i generici non esistono, e ogni istanza è un record a sé.
    /// La finestra sulla lista dei documenti (`host-api.list-documents`).
    record doc-ids-page {
        items: list<doc-id>,
        offset: u32,
        total: u32,
    }
    record backlinks-page {
        items: list<backlink-ref>,
        offset: u32,
        total: u32,
    }
    record documents-page {
        items: list<document-match>,
        offset: u32,
        total: u32,
    }
    record tags-page {
        items: list<tag-count>,
        offset: u32,
        total: u32,
    }
    record neighbors-page {
        items: list<neighbor-ref>,
        offset: u32,
        total: u32,
    }
    record property-values-page {
        items: list<property-count>,
        offset: u32,
        total: u32,
    }
    record vault-health-page {
        items: list<health-issue>,
        offset: u32,
        total: u32,
    }

    variant index-result {
        documents(documents-page),
        backlinks(backlinks-page),
        outline(list<heading>),
        tags(tags-page),
        neighbors(neighbors-page),
        property-values(property-values-page),
        vault-health(vault-health-page),
        custom(json),
    }

    /// COSA SERVE, dichiarato una volta alla registrazione. Senza, il kernel
    /// non può che interpellare tutti in ordine e dedurre da un errore chi era
    /// il destinatario — e due indici che rivendicano la stessa cosa si
    /// oscurano a vicenda in silenzio. Elenco vuoto = questo indice non
    /// risponde a niente, e lo dice.
    routes: func() -> list<query-route>;
    /// Carica lo stato persistente: chiamata una volta, alla registrazione,
    /// prima di qualunque alimentazione. È il punto in cui un indice di terzi
    /// rilegge da `host-api.data-*` ciò che ha già visto — senza, un index
    /// provider in WASM non potrebbe persistere nulla. `host-api` è importato
    /// dal world: non compare fra i parametri.
    activate: func() -> result<_, plugin-error>;
    on-document-indexed: func(doc: document-model);
    on-document-removed: func(id: doc-id);
    /// Verità completa del vault: ciò che l'indice ha in più è morto.
    /// Non è un rebuild — gli immutati non si reindicizzano.
    reconcile: func(ids: list<doc-id>);
    /// Punto di consistenza E di persistenza: al ritorno l'accettato è
    /// visibile alle query e durevole (via `host-api.data-*`).
    flush: func() -> result<_, plugin-error>;
    query: func(query: index-query) -> result<index-result, plugin-error>;
}

/// Il contesto di sessione: quale pannello ha il focus, che documento guarda,
/// cosa c'è selezionato dentro, in che modalità. Lo imposta la shell, lo legge
/// un provider da `host-api.active-context`.
interface session {
    use model.{doc-id, span};

    /// Identità di un pannello di editing (scheda, metà di uno split,
    /// finestra): stringa opaca assegnata dalla shell. Il kernel non la
    /// interpreta e non la inventa — un pannello nasce e muore nell'app.
    type pane-id = string;

    /// Le tre modalità ESCLUSIVE di un pannello (FEATURES 4.1). Ciò che
    /// esclusivo non è (focus mode, zen, typewriter, schermo intero) non sta
    /// qui: non cambia cosa un provider deve fare.
    enum pane-mode { source, live-preview, reading }

    /// Ciò che è selezionato in un pannello — o dove sta il cursore, che è una
    /// selezione vuota.
    ///
    /// `text` è SEMPRE il testo vero dell'editor; `span` c'è solo quando le
    /// sue coordinate valgono anche per il sorgente che il kernel ha in mano
    /// (buffer senza modifiche non salvate). È così che il contratto rende
    /// impossibile ritagliare `read-document` con uno span calcolato su un
    /// altro testo.
    record selection {
        span: option<span>,
        text: string,
    }

    /// Il contesto in cui una view sta girando. Nessun gemello che scrive:
    /// quale nota si guarda e dove si è cliccato sono decisioni dell'utente
    /// sull'app, non capacità concesse a un plugin.
    record view-context {
        pane: pane-id,
        doc: option<doc-id>,
        selection: option<selection>,
        mode: pane-mode,
    }

    /// Le parti del contesto che cambiano da sole. Nessun caso per il
    /// pannello: cambiare pannello è cambiare tutto.
    enum context-kind { document, selection, mode }
    /// Le parti al cui cambio una view invecchia (vedi `view-spec.follows`).
    /// Vuota = la view non guarda il contesto.
    type context-mask = list<context-kind>;
}

/// Modificare **un pezzo** di documento: l'edit come coppia (span, testo) sopra
/// la revisione su cui è stato calcolato. Vedi `crates/fubmd-abi/src/edit.rs`.
interface edit {
    use model.{span};

    /// L'identità del sorgente su cui un edit è stato calcolato. OPACA: solo
    /// l'uguaglianza è contratto — non è un numero d'ordine, non ci si legge
    /// dentro, e come l'host la derivi (impronta, digest, `mtime+size`) non è
    /// promesso a nessuno. La si ottiene da `host-api.document-revision`.
    type revision = string;

    /// Una sostituzione: i byte dentro `span` diventano `text`. Inserire è uno
    /// span vuoto, cancellare è un testo vuoto — un enum a tre casi avrebbe
    /// costretto ogni consumatore a distinguerle per poi trattarle uguali.
    record text-edit {
        /// In byte del sorgente della BASE, mai del testo in corso di
        /// produzione: gli edit sono un insieme, non una sequenza di passi.
        span: span,
        text: string,
    }

    /// Gli edit, e il sorgente su cui sono stati calcolati. La base non è
    /// opzionale: un edit senza base è la corsa che questa firma esiste per
    /// rendere visibile (due modifiche concorrenti che si sovrascrivono in
    /// silenzio). Base che non combacia → `plugin-error.conflict`, e niente
    /// scritto.
    record edit-request {
        base: revision,
        edits: list<text-edit>,
    }

    /// Un edit applicato: dov'è finito nel testo NUOVO (serve a mettere il
    /// cursore) e cosa c'era prima (serve a costruire l'inverso, che è un edit
    /// come gli altri).
    record applied-edit {
        span: span,
        replaced: string,
    }

    /// L'esito: la revisione nuova — con cui si concatena un secondo edit senza
    /// rileggere il documento — e cosa è stato fatto, in ordine di documento.
    record edit-report {
        revision: revision,
        applied: list<applied-edit>,
    }
}

/// View dichiarative (`ViewProvider`).
interface view {
    use ui.{ui-tree, ui-action, view-update};
    use json.{json};
    use events.{event-mask};
    use session.{context-mask};
    use errors.{plugin-error};

    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0016): si chiamava
    /// `view-placement`. Una voce di menu o una scheda di impostazioni non è un
    /// *posto in un layout* ma una superficie a cui ci si attacca, e con tre
    /// soli casi ogni capitolo grande di FEATURES doveva uscire dal contratto
    /// per avere dove stare (§2.2). I tre di prima restano in testa e
    /// nell'ordine: è lo stesso discriminante.
    enum view-surface { left-sidebar, right-sidebar, bottom }
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0016): `render-view` e
    /// `on-action` prendevano il solo id della view, quindi una view era
    /// un esemplare unico e statico — niente "questa view, con questo
    /// parametro" (§2.3).
    record view-instance {
        view: string,
        instance: string,
        params: json,
    }
    record view-spec {
        id: string,
        title: string,
        surface: view-surface,
        /// Dichiarazione di interesse: gli eventi al cui arrivo la shell deve
        /// ridisegnare la view. Vuota = nessun ridisegno event-driven.
        refresh: event-mask,
        /// L'altra metà, per ciò che non è un evento del vault: le parti del
        /// contesto di sessione al cui cambio la view invecchia. Senza,
        /// ridisegnare "al cambio del documento attivo" diventa ridisegnare a
        /// ogni movimento del cursore, appena il contesto porta la selezione.
        follows: context-mask,
    }

    views: func() -> list<view-spec>;
    render-view: func(instance: view-instance) -> result<ui-tree, plugin-error>;
    on-action: func(instance: view-instance, action: ui-action) -> result<view-update, plugin-error>;
}

/// Errore prodotto da un plugin (nativo o WASM).
interface errors {
    variant plugin-error {
        unknown-command(string),
        unknown-view(string),
        unknown-job(string),
        bad-args(string),
        permission-denied(string),
        internal(string),
    }
}

/// Capacità concesse dal kernel a un provider/plugin: l'unico varco col mondo.
///
/// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0013): `storage-get`/`storage-set` —
/// lo stato volatile a chiave→valore — sono stati TOLTI. È l'unica rottura di
/// questo giro e sta qui perché si veda. Con `data-*` (persistente, recintato
/// per plugin) e le impostazioni del §11.1, allo store volatile non resta un
/// caso d'uso: chi vuole ricordare qualcosa oltre la sessione usa i blob, chi
/// vuole una preferenza usa le impostazioni, e chi vuole solo memoria per la
/// durata della sessione ce l'ha già — un provider è un oggetto vivo nel
/// workspace, e a M5 un componente WASM ha la propria memoria lineare. Una
/// capacità che l'host fornisce per qualcosa che il chiamante possiede già è
/// superficie da mantenere e da sandboxare per sempre. Toglierla dopo il
/// freeze sarebbe stata una major: qui è un ritaglio in review.
interface host-api {
    use model.{doc-id};
    use json.{json};
    use events.{event};
    use errors.{plugin-error};
    use jobs.{job-id, job-spec};
    use index.{doc-ids-page, index-query, index-result, page};
    use session.{view-context};

    read-document: func(id: doc-id) -> result<string, plugin-error>;
    write-document: func(id: doc-id, source: string) -> result<_, plugin-error>;
    /// I documenti del vault, in ordine. Senza, `read-document` serve solo per
    /// gli id che arrivano dagli eventi.
    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0019): prende una
    /// finestra e restituisce una pagina. È il metodo con cui un provider si
    /// guarda intorno, e senza finestra clona TUTTO il vault a ogni chiamata.
    list-documents: func(page: option<page>) -> result<doc-ids-page, plugin-error>;
    emit: func(event: event);
    /// Chiede l'esecuzione in background di un job (`plugin.run-job`).
    /// Ritorna subito con l'identità; l'esito arriva come evento `job-done`.
    spawn-job: func(spec: job-spec) -> result<job-id, plugin-error>;

    // --- storage persistente per-plugin --------------------------------------
    //
    // Namespace `.fubmd-data/plugins/<plugin-id>/`, creato e imposto dall'host:
    // il plugin nomina blob con path relativi, non tocca mai il filesystem né
    // conosce la radice del vault. Percorsi assoluti, `..` e separatori di
    // sistema → `permission-denied`. È la capacità che rende scrivibile uno
    // store di snapshot (il versioning) da dentro il contratto.

    /// Legge un blob persistente. Assente → `none`.
    data-read: func(path: string) -> result<option<list<u8>>, plugin-error>;
    /// Scrive (creando le directory intermedie) un blob persistente.
    data-write: func(path: string, bytes: list<u8>) -> result<_, plugin-error>;
    /// Cancella un blob. Assente → successo (idempotente).
    data-remove: func(path: string) -> result<_, plugin-error>;
    /// Elenca i blob sotto un prefisso, path relativi allo spazio del plugin,
    /// ordinati. Prefisso inesistente → lista vuota.
    data-list: func(prefix: string) -> result<list<string>, plugin-error>;

    /// Orologio dell'host: millisecondi dall'epoca Unix. Un plugin non ha
    /// accesso al tempo di sistema (WASI lo può negare, e in test serve
    /// deterministico): il tempo è una capacità come le altre.
    now-unix-millis: func() -> u64;

    // --- interrogazione dell'indice e contesto della sessione ----------------
    //
    // Le due capacità che rendono un `view-provider` un vero provider e non un
    // guscio riempito dall'app: interrogare il vault e sapere quale documento
    // è aperto. Vedi docs/architecture/plugin-boundary.md, "Interrogazione e
    // contesto".

    /// Interroga il vault: backlink e grafo (serviti dal grafo del kernel),
    /// struttura, tag e proprietà (dai modelli in cache), salute del vault, e
    /// ricerca full-text (dai provider registrati). Stessa semantica di
    /// dispatch del kernel.
    query-index: func(query: index-query) -> result<index-result, plugin-error>;
    /// Il contesto del pannello con il focus: quale documento, cosa c'è
    /// selezionato, in che modalità. `none` = la shell non ne ha ancora
    /// pubblicato uno. Lo imposta la shell; una view lo chiede quando ne ha
    /// bisogno. Non ha un gemello che scrive: "quale nota guardo e dove ho
    /// cliccato" è una scelta dell'utente sull'app, non una capacità concessa
    /// a un plugin. Un `doc-id` nudo non basterebbe: con schede e split il
    /// documento attivo smette di essere una variabile globale.
    active-context: func() -> option<view-context>;
}

/// Reazione agli eventi (`EventHandler`).
///
/// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0012): `handle` prendeva un `event`
/// nudo. Adesso prende un `notice`, che è l'evento PIÙ la sua origine — chi ha
/// chiesto l'operazione e di quale lotto fa parte. È una rottura, e sta qui
/// perché si veda: senza l'origine sul parametro, un'automazione su-modifica che
/// scrive non ha modo di riconoscere le proprie scritture e si richiama da sé.
/// Aggiungerla dopo il freeze sarebbe costato una major, o una seconda funzione
/// accanto alla prima con la stessa semantica e un argomento in più.
interface event-handler {
    use events.{notice, event-mask};
    use errors.{plugin-error};

    subscribed: func() -> event-mask;
    handle: func(notice: notice) -> result<_, plugin-error>;
}

/// Ciclo di vita del plugin + manifest e permessi.
interface plugin {
    use errors.{plugin-error};
    use json.{json};
    use options.{option-map};

    /// LINEA DI BASE RITAGLIATA (pre-freeze, decisione 0017): erano tre booleani
    /// (`read-vault`, `write-vault`, `network`). Un booleano non ha dove mettere
    /// il PARAMETRO di un permesso, e «rete» senza allowlist è o tutto o niente
    /// — mentre 20.3 chiede proprio l'allowlist, di rete e di file (§3.5).
    record plugin-permissions {
        granted: option-map,
    }
    record plugin-manifest {
        id: string,
        name: string,
        version: string,
        /// La versione del contratto (`fubmd:abi@X.Y.Z`) contro cui il plugin
        /// è scritto. Regola di caricamento (host): major diversa → rifiuto;
        /// minor del plugin ≤ minor dell'host → accetto (post-freeze il
        /// contratto cresce solo per aggiunta); minor maggiore → rifiuto.
        /// Vedi `fubmd_abi::traits::abi_compatible`.
        abi-version: string,
        permissions: plugin-permissions,
    }

    manifest: func() -> plugin-manifest;
    activate: func() -> result<_, plugin-error>;
    deactivate: func() -> result<_, plugin-error>;
    /// Corpo di un job (vedi `host-api.spawn-job`): eseguito fuori dal
    /// kernel, senza host-api — input nel payload, output nel risultato.
    run-job: func(job: string, payload: json) -> result<json, plugin-error>;
}

/// Il mondo di un plugin: importa le capacità del core, esporta i provider che
/// implementa. Il kernel non distingue nativo da WASM.
world plugin-world {
    import host-api;

    export plugin;
    export format;
    export command;
    export view;
    export index;
    export event-handler;
}
