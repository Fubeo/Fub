// Il mondo di QUESTO componente, che non è `plugin-world`.
//
// `plugin-world` elenca tutto ciò che un plugin *può* fare: diciassette
// famiglie importate e undici interfacce esportate. Un componente che lo
// dichiarasse dovrebbe esportarle tutte e undici — anche `renderer`, anche
// `importer`, anche `syntax` — perché un mondo si implementa per intero, e un
// ping che esporta nove stub per usarne due non è un esempio: è il rumore che
// nasconde l'esempio.
//
// Questo mondo dichiara invece ciò che il ping fa davvero: importa le famiglie
// che usa ed esporta le interfacce che implementa. È il «mezzo plugin» che il
// contratto nomina, e regge perché l'host risolve gli export **una interfaccia
// alla volta** (un `GuestIndices` per `fub:abi/plugin`, un altro per
// `fub:abi/command`) invece di pretendere il mondo intero. Le due scelte sono la
// stessa scelta detta ai due capi del confine, ed è il verbale 0164 a tenerle
// insieme.
//
// Che gli export siano diventati due non è una crescita dell'esempio: è la
// seconda metà della prova. Con uno solo, «una interfaccia alla volta» era una
// frase che nessuno aveva mai messo alla prova — un componente con un export
// solo si risolve uguale che si risolva per interfaccia o per mondo.
package esempio:ping@0.1.0;

world ping {
    import fub:abi/host-env@0.2.0;
    import fub:abi/host-vault-read@0.2.0;

    export fub:abi/plugin@0.2.0;
    export fub:abi/command@0.2.0;
}

// Lo stesso ping, che in più chiede la rete. Era il componente davanti a cui
// l'host rifiutava una famiglia non servita; da quando `host-network` è servita
// si monta, e il test lo usa per vedere il cancello del permesso `fub:network`
// chiudersi a runtime.
world ping-con-rete {
    import fub:abi/host-env@0.2.0;
    import fub:abi/host-vault-read@0.2.0;
    import fub:abi/host-network@0.2.0;

    export fub:abi/plugin@0.2.0;
}

// Lo stesso ping, che chiede `host-transfer-read`: la famiglia che l'host non
// collega fuori da un importer, e che un plugin non può quindi importare. Non
// esiste per fare qualcosa: esiste perché il rifiuto al caricamento abbia un
// componente vero davanti a cui pronunciarsi.
world ping-con-trasferimento {
    import fub:abi/host-env@0.2.0;
    import fub:abi/host-vault-read@0.2.0;
    import fub:abi/host-transfer-read@0.2.0;

    export fub:abi/plugin@0.2.0;
}

// Lo stesso ping, che attraversa le famiglie di scrittura, di struttura, delle
// impostazioni, dello stato di vista, della query, dei comandi e dei servizi:
// un job solo le chiama tutte e riporta cosa ha visto.
world ping-con-famiglie {
    import fub:abi/host-env@0.2.0;
    import fub:abi/host-vault-read@0.2.0;
    import fub:abi/host-vault-write@0.2.0;
    import fub:abi/host-vault-structure@0.2.0;
    import fub:abi/host-settings-read@0.2.0;
    import fub:abi/host-view-state-read@0.2.0;
    import fub:abi/host-view-state-write@0.2.0;
    import fub:abi/host-query@0.2.0;
    import fub:abi/host-commands@0.2.0;
    import fub:abi/host-services@0.2.0;

    export fub:abi/plugin@0.2.0;
}

// Lo stesso ping, che in più attraversa i dati persistiti e la cache privata:
// scrive, rilegge e lista tramite entrambe le famiglie host-data.
world ping-con-dati {
    import fub:abi/host-env@0.2.0;
    import fub:abi/host-vault-read@0.2.0;
    import fub:abi/host-data-read@0.2.0;
    import fub:abi/host-data-write@0.2.0;

    export fub:abi/plugin@0.2.0;
}

// Lo stesso ping, che in più esporta `syntax`: un'interfaccia che
// `plugin-world` prevede e che l'host non collega a nessun adapter. Esiste
// perché il rifiuto al caricamento (`UnservedExports`) abbia davanti un
// componente vero, invece di un plugin che si monta con un export ignorato.
world ping-con-sintassi {
    import fub:abi/host-env@0.2.0;
    import fub:abi/host-vault-read@0.2.0;

    export fub:abi/plugin@0.2.0;
    export fub:abi/syntax@0.2.0;
}
