package esempio:index-provider@0.1.0;

// La porta canonica vive nel contratto ABI; il world la esporta senza
// aggiungere un'interfaccia locale o uno stub alternativo.

world index-provider {
    import fub:abi/host-data-read@0.2.0;
    import fub:abi/host-data-write@0.2.0;
    export fub:abi/plugin@0.2.0;
    export fub:abi/index@0.2.0;
}
