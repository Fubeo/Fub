+// ---------------------------------------------------------------------------
+// Prototipo di Scrittoio 2 (sonda usa-e-getta, non entra nel repository).
+// ---------------------------------------------------------------------------
+async function protoNota(page) {
+  await openNote(page, "Guida/Sintassi di Fub.md");
+  await openWorkbook(page);
+  await page.click(".pane.focus .tab >> nth=0");
+  await page.waitForSelector('.pane.focus .tab[data-index="0"][aria-selected="true"]');
+  for (const path of ["Dati", "Guida"]) {
+    const item = `#file-list li[role="treeitem"][data-path="${path}"]`;
+    if (await page.evaluate((sel) => document.querySelector(sel)?.getAttribute("aria-expanded") === "true", item)) {
+      await page.click(`${item} > .tree-row.folder`);
+    }
+  }
+  const line = page.locator(".pane.focus .cm-line", { hasText: "con tre voci" }).first();
+  const box = await line.boundingBox();
+  if (box) await page.mouse.click(box.x + box.width - 4, box.y + box.height / 2);
+  await page.keyboard.press("End");
+  await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+}
+SCENE.push(...onPage("shell", [
+  { id: "proto-nota", title: "Prototipo: la nota in Live", query: "workbook=1", prepare: protoNota },
+  { id: "proto-nota-barra", title: "Prototipo: la nota con la barra di formattazione", query: "workbook=1&formatbar=1", prepare: protoNota },
+  { id: "proto-icone", title: "Prototipo: le emoji", query: "workbook=1&icone=emoji", prepare: protoNota },
+  {
+    id: "proto-foglio",
+    title: "Prototipo: il foglio",
+    query: "workbook=1",
+    prepare: async (page) => {
+      await openRibbon(page, "any");
+    },
+  },
+  {
+    id: "proto-lavagna",
+    title: "Prototipo: la lavagna",
+    prepare: async (page) => {
+      await openFromTree(page, "Progetti/Mappa del banco.canvas", ".pane.focus .canvas-toolbar");
+      await page.waitForTimeout(400);
+    },
+  },
+]));
