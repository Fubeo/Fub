 /// struttura no: le sue voci sono i titoli della nota.
 function treeOf(view: string): UiNode | undefined {
+  // Sonda del pianificatore pre-alpha (solo nella copia di cattura): il cestino
+  // pieno, con la forma di `fub-features/src/trash.rs`.
+  if (view === "trash" && new URLSearchParams(globalThis.location.search).get("cestino") === "pieno") {
+    const riga = (key: string, title: string, when: string): UiNode => ({
+      node: "stack", dir: "row", gap: 1, key, children: [
+        { node: "list_item", title, subtitle: `Cestinata il ${when}`, action: null, selected: false },
+        { node: "button", label: "Ripristina", intent: "primary", action: { action: "restore", payload: { entry: key } } },
+      ],
+    } as unknown as UiNode);
+    return {
+      node: "stack", dir: "column", gap: 1, children: [
+        { node: "list", items: [
+          riga(".trash/3-Idee sparse.md", "Idee sparse", "5 novembre 2026, 10:42"),
+          riga(".trash/2-Lista della spesa.md", "Lista della spesa", "4 novembre 2026, 18:03"),
+          riga(".trash/1-Vecchio indice.md", "Vecchio indice", "28 ottobre 2026, 09:15"),
+        ] },
+        { node: "button", label: "Svuota il cestino", intent: "danger", action: { action: "empty", payload: null } },
+      ],
+    } as unknown as UiNode;
+  }
   const tree = TREES[view];
   return tree && view !== "outline" ? inShellLanguage(tree) : tree;
 }
