{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FubMD",
  "version": "0.1.0",
  "identifier": "dev.fubmd.app",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/frontend\" && npm run dev'",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/frontend\" && npm run build'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FubMD",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
