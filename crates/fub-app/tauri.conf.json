{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fub",
  "version": "0.1.0",
  "identifier": "dev.fub.app",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/frontend\" && npm run dev'",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/frontend\" && npm run build'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fub",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' asset:; media-src 'self' asset:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
