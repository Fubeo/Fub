<?xml version="1.0" encoding="utf-8"?>
<!-- Fub — layout widget (MobileOwner P14/F37).
     Posizione finale: gen/android/app/src/main/res/layout/fub_widget.xml.
     4 pulsanti >=48dp: Nuova, Giornaliera, Cerca, Vai. Solo tap -> fub://. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fub_widget_new"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Nuova" />

        <Button
            android:id="@+id/fub_widget_daily"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Giornaliera" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fub_widget_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cerca" />

        <Button
            android:id="@+id/fub_widget_switcher"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Vai" />
    </LinearLayout>
</LinearLayout>
