    "@codemirror/view": "^6.36.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
