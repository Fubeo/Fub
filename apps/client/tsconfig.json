{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    // Solo i tipi di Vite (per `import.meta.glob`, che il presidio del §1.3
    // usa per leggere i sorgenti). Deliberatamente NON quelli di Node: la
    // shell gira in una webview, e non avere `process`/`fs` a tiro è ciò che
    // impedisce di scriverci codice che nell'app impacchettata non esiste.
    "types": ["vite/client"],
    "noEmit": true
  },
  // `bench/` è codice come `src/`, e i suoi `.ts` girano nello stesso motore:
  // il tipo lo controlla lo stesso `tsc`. I `.mjs` del banco no, ed è la riga
  // di confine — quelli girano in Node, che qui i tipi non ce li ha apposta.
  "include": ["src", "bench"]
}
