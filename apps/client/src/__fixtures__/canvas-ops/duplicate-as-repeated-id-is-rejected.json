{
  "about": "duplicate con due copie che vogliono lo stesso id (x, x): la seconda trova il primo preso, DuplicateId.",
  "before": { "nodes": [
    { "id": "a", "type": "text", "x": 0, "y": 0, "width": 100, "height": 60, "text": "a" },
    { "id": "b", "type": "text", "x": 200, "y": 0, "width": 100, "height": 60, "text": "b" }
  ] },
  "ops": [{ "op": "duplicate", "ids": ["a", "b"], "as": ["x", "x"] }],
  "expect": { "outcome": "rejected", "error": { "kind": "DuplicateId", "index": 0, "id": "x" } }
}
