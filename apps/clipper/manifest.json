{
  "manifest_version": 3,
  "name": "Fub Clipper",
  "version": "0.1.0",
  "description": "Clip articles, selections and highlights to Fub. Works fully offline without any assistant; optional assistant is opt-in and never sends anything by itself.",
  "minimum_chrome_version": "109",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Clip to Fub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "contextMenus", "nativeMessaging", "notifications"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/", "http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "fub-clip": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open the Fub clipper popup"
    }
  }
}
