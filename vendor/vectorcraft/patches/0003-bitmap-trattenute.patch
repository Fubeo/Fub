+/// Patch di Fub (`0003-bitmap-trattenute`): finché è vivo, i file i cui byte iniziano con `held`
+/// non si leggono, così un bitmap chiesto in un disegno non è pronto prima che quel disegno
+/// finisca, per quanto il thread del test resti fermo. Senza, il lavoratore può finire fra
+/// `schedule` e la rilettura della cache in `draw_placed_bitmap`, e il primo disegno mostra già i
+/// bitmap. Lasciato (anche da un test che fallisce), i file si leggono di nuovo. Lo usa soltanto
+/// un test che tiene [`serial`].
+struct Held;
+
+static HELD: std::sync::Mutex<bool> = std::sync::Mutex::new(false);
+static HELD_CHANGED: std::sync::Condvar = std::sync::Condvar::new();
+
+impl Held {
+    fn hold() -> Self {
+        *HELD.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = true;
+        Held
+    }
+
+    /// Aspetta finché i file sono trattenuti (al più 10 s: un test che non li lascia fallisce,
+    /// non resta appeso).
+    fn wait() {
+        let held = HELD.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let timeout = std::time::Duration::from_secs(10);
+        let (held, _) = HELD_CHANGED.wait_timeout_while(held, timeout, |held| *held).unwrap_or_else(std::sync::PoisonError::into_inner);
+        assert!(!*held, "held files never let go");
+    }
+}
+
+impl Drop for Held {
+    fn drop(&mut self) {
+        *HELD.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = false;
+        HELD_CHANGED.notify_all();
+    }
+}
+
 fn doc(key: &str) -> Document {
     doc_with(key, format!("{{\"doc\": \"{key}\"}}").as_bytes())
 }
