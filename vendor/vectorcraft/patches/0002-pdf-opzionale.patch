+/// Without the PDF reader and writer a `.pdf`, `.ai` or `.eps` path is refused with the reason,
+/// never saved as a native file under that name, and opening such a file says why too.
+#[cfg(not(feature = "pdf"))]
+#[test]
+fn without_the_pdf_writer_its_files_are_refused_by_name() {
+    let d = dir("no-pdf");
+    let mut s = session();
+    rect(&mut s);
+    for name in ["doc.pdf", "doc.ai", "doc.ait", "doc.eps", "doc.ps"] {
+        let p = path(&d, name);
+        for cmd in ["file.saveAs", "file.saveCopy"] {
+            let e = s.execute(cmd, &json!({"path": p})).unwrap_err().to_string();
+            assert!(e.contains("not available in this build"), "{cmd} {name}: {e}");
+            assert!(!std::path::Path::new(&p).exists(), "{cmd} {name}: nothing is written");
+        }
+    }
+    for format in ["pdf", "ai", "eps"] {
+        let e = s.execute("document.export", &json!({"format": format})).unwrap_err().to_string();
+        assert!(e.contains("not available in this build"), "export {format}: {e}");
+        let e = s.execute("file.saveCopy", &json!({"path": path(&d, "doc.vectorcraft"), "format": format})).unwrap_err().to_string();
+        assert!(e.contains("not available in this build"), "save {format}: {e}");
+    }
+    let pdf = path(&d, "art.pdf");
+    std::fs::write(&pdf, b"%PDF-1.7\n%%EOF\n").unwrap();
+    let e = s.execute("document.open", &json!({"path": pdf})).unwrap_err().to_string();
+    assert!(e.contains("not available in this build"), "open: {e}");
+    let _ = std::fs::remove_dir_all(d);
+}
