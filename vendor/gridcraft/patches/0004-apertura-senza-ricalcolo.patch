+    /// A workbook as its file saved it: the dependency graph is built but nothing is
+    /// evaluated, so every value is the one the file holds until an edit reaches it.
+    pub fn from_saved(wb: Workbook, path: Option<String>, title: String) -> DocState {
+        let mut calc = Calc::new();
+        calc.rebuild(&wb);
+        Self::with_calc(wb, calc, path, title)
+    }
+    fn with_calc(wb: Workbook, calc: Calc, path: Option<String>, title: String) -> DocState {
