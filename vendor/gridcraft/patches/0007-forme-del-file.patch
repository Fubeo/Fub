+}
+
+/// The Excel 2010 conditional format elements kept as the file had them, with their prefixes.
+const X14_CF_ELEMENTS: &[(&str, &str)] = &[
+    ("conditionalFormattings", "x14:"),
+    ("conditionalFormatting", "x14:"),
+    ("cfRule", "x14:"),
+    ("dataBar", "x14:"),
+    ("colorScale", "x14:"),
+    ("iconSet", "x14:"),
+    ("cfvo", "x14:"),
+    ("cfIcon", "x14:"),
+    ("color", "x14:"),
+    ("fillColor", "x14:"),
+    ("borderColor", "x14:"),
+    ("negativeFillColor", "x14:"),
+    ("negativeBorderColor", "x14:"),
+    ("axisColor", "x14:"),
+    ("f", "xm:"),
+    ("sqref", "xm:"),
+];
+const X14_CF_ATTRS: &[&str] = &[
+    "type",
+    "priority",
+    "id",
+    "operator",
+    "stopIfTrue",
+    "activePresent",
+    "text",
+    "rank",
+    "bottom",
+    "percent",
+    "aboveAverage",
+    "equalAverage",
+    "stdDev",
+    "minLength",
+    "maxLength",
+    "border",
