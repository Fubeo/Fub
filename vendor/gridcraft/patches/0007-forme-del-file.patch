+    "direction",
+    "negativeBarColorSameAsPositive",
+    "negativeBarBorderColorSameAsPositive",
+    "axisPosition",
+    "gte",
+    "iconSet",
+    "showValue",
+    "reverse",
+    "custom",
+    "iconId",
+    "rgb",
